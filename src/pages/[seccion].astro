---
// Página provisional "Próximamente" para cada sección del menú.
// Al construir una sección real, crear src/pages/<slug>.astro: tiene prioridad sobre esta ruta dinámica.
import type { GetStaticPaths } from 'astro';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { secciones, type Seccion } from '../data/secciones';

export const getStaticPaths = (() =>
  secciones
    .filter((s) => s.href !== '/')
    .map((s) => ({ params: { seccion: s.href.slice(1) }, props: { seccion: s } }))) satisfies GetStaticPaths;

const { seccion } = Astro.props as { seccion: Seccion };
---

<BaseLayout title={seccion.title} description={seccion.description}>
  <section class="mx-auto flex max-w-3xl flex-col items-center px-4 py-20 text-center sm:px-6">
    <span class="flex size-20 items-center justify-center rounded-full bg-navy-900 text-gold-300 shadow-card">
      <Icon name={seccion.icon} class="size-10" aria-hidden="true" />
    </span>
    <h1 class="mt-6 font-display text-3xl font-bold text-navy-900 sm:text-4xl">{seccion.title}</h1>
    <p class="mt-3 text-lg text-ink/80">{seccion.description}</p>
    <p class="mt-8 rounded-full bg-gold-300/40 px-5 py-2 text-sm font-semibold text-navy-900">
      Próximamente
    </p>
    <a href="/" class="mt-8 font-semibold text-navy-800 underline decoration-gold-500 underline-offset-4 hover:text-gold-500">
      ← Volver al inicio
    </a>
  </section>
</BaseLayout>
