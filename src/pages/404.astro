---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada">
  <section class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6">
    <p class="font-display text-6xl font-bold text-gold-500">404</p>
    <h1 class="mt-4 font-display text-3xl font-bold text-navy-900">Página no encontrada</h1>
    <p class="mt-3 text-lg text-ink/80">La página que buscas no existe o fue movida.</p>
    <a href="/" class="mt-8 inline-block rounded-xl bg-navy-900 px-6 py-3 font-semibold text-gold-300 hover:bg-navy-800">
      Volver al inicio
    </a>
  </section>
</BaseLayout>
