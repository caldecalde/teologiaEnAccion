---
import { site } from '../config/site';
import CfImage from './CfImage.astro';
import Logo from './Logo.astro';
import MobileMenu from './MobileMenu.vue';
import NavLinks from './NavLinks.astro';
---

<header class="relative overflow-hidden bg-navy-900 text-white">
  <!-- Fondo: Biblia abierta a la derecha, desvanecida hacia el azul -->
  <div class="pointer-events-none absolute inset-y-0 right-0 w-full md:w-3/5" aria-hidden="true">
    <CfImage
      src="hero/biblia.svg"
      alt=""
      width={1200}
      height={400}
      sizes="(min-width: 768px) 60vw, 100vw"
      priority
      class="h-full w-full object-cover opacity-40 md:opacity-100"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-navy-900 via-navy-900/70 to-transparent"></div>
  </div>

  <div class="relative mx-auto flex max-w-7xl items-center gap-4 px-4 py-4 sm:px-6 md:gap-6 md:py-8 lg:px-8">
    <a href="/" class="flex items-center gap-3 md:gap-5" aria-label={`${site.name} — Inicio`}>
      <Logo class="h-12 w-auto shrink-0 sm:h-14 md:h-20" />
      <span class="hidden h-14 w-px bg-gold-500/70 sm:block md:h-20" aria-hidden="true"></span>
      <span class="font-display leading-none tracking-wide">
        <span class="block text-xl font-semibold text-cream-50 sm:text-2xl md:text-4xl">TEOLOGÍA</span>
        <span class="mt-1 block text-xl font-semibold text-gold-500 sm:text-2xl md:text-4xl">EN ACCIÓN</span>
      </span>
    </a>

    <span class="hidden h-16 w-px bg-gold-500/50 lg:block" aria-hidden="true"></span>
    <p class="hidden text-lg text-cream-50/90 italic lg:block">
      {site.tagline.join('  ·  ')}
    </p>

    <div class="ml-auto lg:hidden">
      <MobileMenu client:media="(max-width: 1023px)">
        <NavLinks variant="mobile" />
      </MobileMenu>
    </div>
  </div>

  <!-- Lema visible en móvil/tablet -->
  <p class="relative border-t border-white/10 px-4 py-2 text-center text-xs text-cream-50/80 italic sm:text-sm lg:hidden">
    {site.tagline.join(' · ')}
  </p>
</header>
