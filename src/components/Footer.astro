---
import { Icon } from 'astro-icon/components';
import { nav, site } from '../config/site';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
const social = [
  { href: site.social.youtube, label: 'YouTube', icon: 'lucide:youtube' },
  { href: site.social.facebook, label: 'Facebook', icon: 'lucide:facebook' },
  { href: site.social.instagram, label: 'Instagram', icon: 'lucide:instagram' },
].filter((s) => s.href);
---

<footer class="mt-8 bg-navy-900 text-cream-50/80">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-3 lg:px-8">
    <div>
      <a href="/" class="flex items-center gap-3">
        <Logo class="h-12 w-auto" />
        <span class="font-display text-lg leading-tight font-semibold tracking-wide">
          <span class="text-cream-50">TEOLOGÍA</span><br /><span class="text-gold-500">EN ACCIÓN</span>
        </span>
      </a>
      <p class="mt-4 max-w-xs text-sm leading-relaxed">{site.description}</p>
    </div>

    <nav aria-label="Enlaces del pie de página">
      <h2 class="font-display text-sm font-semibold tracking-widest text-gold-300 uppercase">Secciones</h2>
      <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
        {nav.map((item) => (
          <li><a href={item.href} class="transition hover:text-gold-300">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="font-display text-sm font-semibold tracking-widest text-gold-300 uppercase">Síguenos</h2>
      <ul class="mt-4 flex gap-3">
        {social.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              class="inline-flex size-11 items-center justify-center rounded-full border border-gold-500/40 text-gold-300 transition hover:bg-gold-500 hover:text-navy-900"
            >
              <Icon name={s.icon} class="size-5" aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10 py-5 text-center text-xs">
    © {year} {site.name}. Todos los derechos reservados.
  </div>
</footer>
